# Local server port.
PORT=5180

# Required in production. Local development defaults to "workshop".
FACILITATOR_PIN=choose-a-private-pin

# Required in production. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional. The default is .data/games.json.
GAME_DATA_FILE=.data/games.json

# Optional. When set, PostgreSQL replaces file storage.
# DATABASE_URL=postgresql://user:password@localhost:5432/common_waters
